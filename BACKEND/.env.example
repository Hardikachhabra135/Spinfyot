# Spinfyot Backend Environment Configuration

# Server Configuration
PORT=5000
NODE_ENV=production

# Database Configuration (TiDB Cloud / MySQL)
# Option 1: Full Connection String (Recommended for TiDB Cloud)
# DATABASE_URL=mysql://<username>:<password>@gateway01.<region>.prod.aws.tidbcloud.com:4000/<dbname>?ssl={"rejectUnauthorized":true}

# Option 2: Individual Connection Parameters
DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=your_tidb_username
DB_PASS=your_tidb_password
DB_NAME=spinfyot
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true

# Security & Authentication
JWT_SECRET=your_super_secret_production_jwt_key_min_32_chars

# CORS / Allowed Origins (Comma-separated list of allowed domains)
FRONTEND_URL=https://spinfyot.vercel.app
ADMIN_URL=https://spinfyot-admin.vercel.app
ALLOWED_ORIGINS=https://spinfyot.vercel.app,https://spinfyot-admin.vercel.app,http://localhost:5173,http://localhost:5174

# ==========================================
# UPTIME MONITORING & ALERTS
# ==========================================
# Time in milliseconds between checks (Default: 300000 = 5 mins)
MONITOR_INTERVAL_MS=300000
# Email address to send downtime alerts to
MONITOR_ALERT_EMAIL=admin@example.com

# SMTP Credentials for sending alert emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

